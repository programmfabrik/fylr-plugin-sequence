[
    {
        "name": "PUT /api/v1/plugin/manage/upload",
        "request": {
            "endpoint": "plugin/manage/upload",
            "method": "PUT",
            "body_file": "@../../build/fylr-plugin-sequence.zip",
            "body_type": "file",
            "query_params": {
                "filename": "fylr-plugin-sequence.zip"
            }
        },
        "response": {
            "statuscode": 200,
            "body": {
                "id:control": {
                    "is_number": true
                },
                "name": "fylr-plugin-sequence",
                "type": "zip"
            }
        },
        "store_response_gjson": {
            "plugin_id": "body.id"
        }
    }
]
